{
  "name": "@local/douyin-research-plugin",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Conversation-first Douyin account and video research plugin for DSH.",
  "keywords": ["douyin", "research", "video-analysis", "dsh-plugin"],
  "exports": { ".": "./index.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "lib/*.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "test": "node --test", "check": "node --check index.js && for f in lib/*.js; do node --check \"$f\"; done", "pack:check": "npm pack --dry-run" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "@deepseek-ai/schemastery": "~3.19.0" },
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "https://github.com/bodinggg/douyin-research-plugin.git" },
  "license": "MIT"
}
